{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/work/find-my-pg", "destination": "/work/find-my-pg.html" },
    { "source": "/work/dream-wash", "destination": "/work/dream-wash.html" },
    { "source": "/work/outvox", "destination": "/work/outvox.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}

